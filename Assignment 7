import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Allow the user to provide the CSV file name as input
file_name = input("Enter the CSV file name (e.g., sample_data_assignment_07.csv): ").strip()

try:
    df = pd.read_csv(file_name)
except FileNotFoundError:
    print(f"Error: '{file_name}' not found. Please check the file name and path.")
    exit()

# Display the dataset
print("\nDataset:")
print(df)

# 2. Calculate and display averages
avg_maths = df["Maths"].mean()
avg_python = df["Python"].mean()
avg_attendance = df["Attendance"].mean()

print("\n--- Summary Averages ---")
print(f"Average Maths Marks:      {avg_maths:.2f}")
print(f"Average Python Marks:     {avg_python:.2f}")
print(f"Average Attendance (%):   {avg_attendance:.2f}")

# --- Original Plots ---

# Line Plot
plt.figure(figsize=(7, 4.5))
plt.plot(df["Student"], df["Python"], marker="o", color="royalblue", label="Python Marks")
plt.title("Python Marks of Students")
plt.xlabel("Student")
plt.ylabel("Python Marks")
plt.legend()
plt.grid(True)
plt.show()

# Bar Plot
plt.figure(figsize=(7, 4.5))
plt.bar(df["Student"], df["Maths"], color="seagreen", label="Maths Marks")
plt.title("Maths Marks of Students")
plt.xlabel("Student")
plt.ylabel("Maths Marks")
plt.legend()
plt.show()

# Scatter Plot
plt.figure(figsize=(7, 4.5))
plt.scatter(df["Maths"], df["Python"], s=70, color="darkorange", label="Student Scores")
plt.title("Maths vs Python Marks")
plt.xlabel("Maths Marks")
plt.ylabel("Python Marks")
plt.legend()
plt.grid(True)
plt.show()

# Correlation Matrix and Heatmap
correlation = df[["Maths", "Python", "Attendance"]].corr()
print("\nCorrelation Matrix:")
print(correlation)

plt.figure(figsize=(6.5, 5))
sns.heatmap(correlation, annot=True, cmap="Blues", vmin=-1, vmax=1)
plt.title("Correlation Heatmap")
plt.show()

# --- New Challenge Plots ---

# 3. Histogram of Python Marks
plt.figure(figsize=(7, 4.5))
plt.hist(df["Python"], bins=5, color="mediumpurple", edgecolor="black", label="Frequency")
plt.title("Distribution of Python Marks (Histogram)")
plt.xlabel("Python Marks")
plt.ylabel("Number of Students")
plt.legend()
plt.grid(axis="y", linestyle="--", alpha=0.7)
plt.show()

# 4. Box Plot for Maths and Python Marks
plt.figure(figsize=(7, 4.5))
plt.boxplot([df["Maths"], df["Python"]], labels=["Maths", "Python"], patch_artist=True)
plt.title("Comparison of Maths and Python Marks (Box Plot)")
plt.xlabel("Subject")
plt.ylabel("Marks")
plt.grid(axis="y", linestyle="--", alpha=0.7)
plt.show()

# 5. Pie Chart showing the number of students from each city
city_counts = df["City"].value_counts()

plt.figure(figsize=(6.5, 6.5))
plt.pie(
    city_counts,
    labels=city_counts.index,
    autopct="%1.1f%%",
    startangle=140,
    colors=["#66b3ff", "#99ff99", "#ffcc99"],
)
plt.title("Student Distribution by City")
plt.legend(city_counts.index, title="Cities", loc="upper right")
plt.show()
